  "backend": {
    "id": "whisperx",
    "options": {
      "device": "cpu",
      "alignment_device": "cpu",
      "diarization_device": "cpu",
      "threads": 5,
      "batch_size": 4,
      "merge_consecutive_speakers": true,
      "speaker_merge_gap_sec": 0.45
    }
  }
}
