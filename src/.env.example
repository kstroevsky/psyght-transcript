# Required: Hugging Face token for gated pyannote models (first run only).
HF_TOKEN=hf_xxx

# ── Optional overrides ────────────────────────────────────────────────────────

# Go offline after models are downloaded (no network access at runtime).
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Override the HF model cache location.
# HF_HOME=~/.cache/huggingface

# Force a specific Whisper model for ALL languages (bypasses LANG_MODEL_MAP routing).
# WHISPERX_MODEL_NAME=large-v3

# ASR device: cuda | cpu | mps  (default: cuda if available, else cpu)
# On Apple Silicon, `mps` requests are logged and safely downgraded to CPU for ASR because
# faster-whisper/CTranslate2 prebuilt binaries do not provide an MPS backend.
# WHISPERX_DEVICE=cpu

# Diarization device: cuda | cpu | mps  (default: cuda if available, else cpu)
# On Apple Silicon, diarization still defaults to CPU for stability; explicit `mps` is only
# used if pyannote preflight succeeds, otherwise it falls back to CPU and records the reason.
# WHISPERX_DIARIZE_DEVICE=cpu

# Compute type: float16 | int8 | float32  (default: float16 on cuda, int8 on cpu)
# WHISPERX_COMPUTE_TYPE=int8

# ASR batch size (default: 8 on cuda, 2 on cpu)
# WHISPERX_ASR_BATCH_SIZE=2

# Faster-whisper CPU thread count (default: all local CPU cores on cpu unless overridden)
# WHISPERX_ASR_THREADS=4

# VAD method: pyannote | silero  (default: pyannote on cuda, silero on cpu)
# WHISPERX_ASR_VAD_METHOD=silero

# VAD chunk size in seconds (default: 30 on cuda, 10 on cpu)
# WHISPERX_ASR_VAD_CHUNK_SIZE=15

# Optional helper override for CTC beam-search + KenLM decoding.
# The helper should point at a Python 3.11/3.12 venv created via:
# `python phase1/tools/setup_ctc_kenlm_helper.py`
# PHASE1_CTC_KENLM_PYTHON=/absolute/path/to/phase1/.ctc-kenlm-venv/bin/python

# Optional override for the local CTC KenLM asset root. Defaults to `phase1/models/ctc_kenlm`.
# PHASE1_CTC_KENLM_MODEL_ROOT=/absolute/path/to/phase1/models/ctc_kenlm

# Optional override for the isolated Qwen3-ASR helper env created via:
# `python phase1/tools/setup_qwen_asr_helper.py`
# PHASE1_QWEN_ASR_PYTHON=/absolute/path/to/phase1/.qwen-asr-venv/bin/python

# Optional override for repo-local Qwen ASR model downloads. Defaults to `phase1/models/qwen_asr`.
# PHASE1_QWEN_ASR_MODEL_ROOT=/absolute/path/to/phase1/models/qwen_asr

# Optional override for serial vs parallel Hugging Face Qwen snapshot downloads.
# Keep this at `1` on hosts where large shard downloads stall under parallel fetch.
# PHASE1_QWEN_ASR_DOWNLOAD_WORKERS=1

# Optional Hugging Face fallback for large Qwen snapshots on hosts where Xet-backed downloads hang.
# HF_HUB_DISABLE_XET=1

# Pyannote model overrides (rarely needed).
# WHISPERX_PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# WHISPERX_PYANNOTE_SEGMENTATION_MODEL=pyannote/segmentation-3.0
